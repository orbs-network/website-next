# Copy to .env.local and fill in values.

# Contentful Delivery API — required at build time (pages are prerendered)
# and at runtime (ISR revalidation refetches).
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Contentful Preview API — required for draft-mode preview (/api/preview).
CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# Shared secrets you generate yourself (any long random string).
# CONTENTFUL_PREVIEW_SECRET    — `secret` query param on the Contentful preview URL
# CONTENTFUL_REVALIDATE_SECRET — `x-contentful-webhook-secret` header on the webhook
CONTENTFUL_PREVIEW_SECRET=
CONTENTFUL_REVALIDATE_SECRET=

# Let `next build` finish when Contentful cannot answer. Set to 1 to enable.
#
# Normally a Contentful failure fails the build, which is right: a site that
# builds green with no content is worse than one that refuses to build. With
# this set, an AVAILABILITY failure (402 quota/blocked, 429, 5xx) instead logs
# and returns empty, so work that does not touch the blog can still ship while
# the space is down. A bad token or wrong space id (401/403/404) stays fatal.
#
# BUILD ONLY. It has no effect at request time, deliberately — the sitemap and
# RSS routes render per request, and serving those empty would tell crawlers
# the whole archive is gone, with a 200 the CDN then caches for 24 hours. A 500
# they retry is much better. See the note in src/app/lib/api.ts.
#
# NOT SELF-HEALING. A degraded build writes empty 200s into the deployment's
# ISR cache for /, /blog and /news. Contentful recovering does not fire the
# revalidation webhook, so those stay empty until their window expires. When
# the space comes back: UNSET THIS AND REDEPLOY. Do not wait it out.
#
# TEMPORARY. The failure mode is an empty blog rather than a red build, which
# is the kind of thing that ships unnoticed. Leave it unset unless the space is
# actually down, and unset it before the DNS cutover (#39) — after that the
# Vercel deployment has real readers. See #115.
CONTENTFUL_ALLOW_DEGRADED=

# NOTE: there is deliberately no SITE_URL here any more. The canonical origin
# is a constant in `src/app/lib/site.ts`, because a value that has to be
# identical in every environment for canonicals to be correct is not
# configuration — making it configurable is what #71 was. Changing the domain
# is a code change.

# Force robots.txt to allow or block indexing, overriding the environment
# check. Rarely needed — set to "false" to block a production-like deployment,
# or "true" to index one that isn't detected as production.
ALLOW_INDEXING=

# Optional, defaults to en-US. Must match the space's locale — webhook payloads
# key field values by locale.
CONTENTFUL_LOCALE=

# --- contact form (src/app/api/contact) -----------------------------------
# Resend API key. Send-only restricted — it can send mail and nothing else, so
# it cannot read or manage the account if it leaks. Required at RUNTIME only:
# the route is `force-dynamic` and is never evaluated during a build.
#
# Without it the route returns 500 and the form tells the reader their message
# was not sent. That is deliberate — the legacy form's failure mode was a
# success screen over a dead backend.
RESEND_API_KEY=

# The Resend audience the newsletter signup writes to. Required — there is no
# sensible default for an audience ID, and one that happened to work in a
# preview while silently writing to the wrong list in production is worse than
# a loud failure. Create it at https://resend.com/audiences.
RESEND_AUDIENCE_ID=

# Who the forwarded enquiry appears to be from. REQUIRED — no default.
#
# There is deliberately no fallback to Resend's sandbox sender. Measured
# against the live API:
#
#   onboarding@resend.dev -> delivered@resend.dev  200, id returned
#   onboarding@resend.dev -> hello@orbs.com        403 "You can only send
#                                                  testing emails to your own
#                                                  email address"
#
# A sandbox default would therefore pass every smoke test and 502 on every
# real enquiry. Unset, the route logs and returns 500 instead.
#
# BLOCKED until orbs.com is verified at https://resend.com/domains — sending
# from it today returns 403 "The orbs.com domain is not verified". Once the
# DNS records are in, set this to "Orbs <noreply@orbs.com>".
CONTACT_FROM_EMAIL=

# Where enquiries are forwarded. Optional, defaults to hello@orbs.com.
# Nothing is ever sent to the person who submitted the form.
CONTACT_TO_EMAIL=

# --- migration script only (scripts/orbs-website-migration) ---------------
# Contentful Management API token. WRITE access to the entire space — keep it
# local. Never add it to Vercel or any CI environment.
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_ENVIRONMENT_ID=master
